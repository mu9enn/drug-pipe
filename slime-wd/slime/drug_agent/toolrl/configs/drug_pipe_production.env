# Drug-Pipe extensions over the ToolRL turn/action substrate.
V6_PROFILE=drug_pipe_production
TOOLRL_REWARD_MODE=hierarchical
TOOLRL_STRUCTURED_FINAL_EXACT=1
TOOLRL_PROMPT_STRATEGY=drug_pipe_skill_discovery
TOOLRL_VIEW=curated_static
TOOLRL_ENABLE_DYNAMIC_FILTER=0
TOOLRL_REQUIRE_EXACT_EPOCH=1
N_SAMPLES_PER_PROMPT=4
ROLLOUT_TEMPERATURE=1.0
EPS_CLIP=0.2
EPS_CLIP_HIGH=0.2
USE_KL_LOSS=1
KL_COEF=0
KL_LOSS_COEF=0.001
KL_LOSS_TYPE=low_var_kl
DISABLE_REWARDS_NORMALIZATION=0
