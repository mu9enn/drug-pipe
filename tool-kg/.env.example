# Required by the Stage1/Stage2/Stage3 Claude Code runners.
MOLCLAW_SCP_API_KEY=
MOLCLAW_AGENT_PROVIDER=

# Preferred MCP configuration names.
MOLCLAW_SCP_MCP_SERVER_NAME=molclaw-scp
MOLCLAW_SCP_MCP_URL=
MOLCLAW_SCP_MCP_AUTH_HEADER=SCP-HUB-API-KEY
MOLCLAW_SCP_MCP_AUTH=

# Optional alias used by the MCP snapshot client. If unset, MOLCLAW_SCP_MCP_URL is used.
MOLCLAW_SCP_SERVER_URL=

MOLCLAW_VS_MCP_SERVER_NAME=molclaw-vs
MOLCLAW_VS_MCP_URL=
MOLCLAW_VS_MCP_AUTH_HEADER=
MOLCLAW_VS_MCP_AUTH=

# Backward-compatible aliases used by older configurations.
MOLCLAW_AGENT_MCP_SERVER_NAME=
MOLCLAW_AGENT_MCP_SERVER_URL=
MOLCLAW_AGENT_MCP_AUTH_HEADER=
MOLCLAW_AGENT_MCP_AUTH_TOKEN=

# Optional external BindingDB TSV consumed by scripts/build_science_kb.py.
BINDINGDB_PATH=
