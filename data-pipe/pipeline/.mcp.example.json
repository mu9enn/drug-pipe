{
  "mcpServers": {
    "molclaw-vs": {
      "type": "http",
      "url": "https://<your-vs-mcp>/mcp",
      "headers": {
        "Authorization": "<MOLCLAW_VS_MCP_AUTH>"
      }
    },
    "molclaw-scp": {
      "type": "http",
      "url": "https://<your-scp-mcp>/mcp",
      "headers": {
        "SCP-HUB-API-KEY": "<MOLCLAW_SCP_MCP_AUTH>"
      }
    }
  }
}
