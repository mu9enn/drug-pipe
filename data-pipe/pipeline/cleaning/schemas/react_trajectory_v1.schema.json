{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drug-pipe.local/schemas/react_trajectory_v1.schema.json",
  "title": "Drug-Pipe canonical ReAct trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "messages"],
  "properties": {
    "schema_version": {
      "const": "drug_agent_sft_react_json_v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content", "step_loss_mask"],
        "properties": {
          "role": {
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string"
          },
          "step_loss_mask": {
            "enum": [0, 1]
          }
        }
      }
    }
  }
}
