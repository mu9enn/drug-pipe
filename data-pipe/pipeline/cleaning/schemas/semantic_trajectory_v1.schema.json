{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "user_task", "events", "metadata"],
  "properties": {
    "schema_version": {"const": "drug_agent_semantic_trajectory_v1"},
    "id": {"type": "string", "minLength": 1},
    "user_task": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "source_message_id", "reasoning", "tool_calls", "final_answer"],
            "properties": {
              "type": {"const": "assistant_decision"},
              "source_message_id": {"type": "string", "minLength": 1},
              "reasoning": {"type": "string"},
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "arguments", "source_tool_use_id"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "arguments": {"type": "object"},
                    "source_tool_use_id": {"type": "string", "minLength": 1}
                  }
                }
              },
              "final_answer": {"type": ["string", "null"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "source_tool_use_id", "status", "is_error", "content"],
            "properties": {
              "type": {"const": "tool_observation"},
              "name": {"type": "string", "minLength": 1},
              "source_tool_use_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "is_error": {"type": "boolean"},
              "content": {},
              "compaction": {"type": "object"}
            }
          }
        ]
      }
    },
    "metadata": {"type": "object"}
  }
}
