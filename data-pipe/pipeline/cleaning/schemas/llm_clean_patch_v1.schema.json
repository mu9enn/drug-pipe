{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drug-pipe.local/schemas/llm_clean_patch_v1.schema.json",
  "title": "Drug-Pipe restricted LLM prose-cleaning patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "edits"],
  "properties": {
    "schema_version": {
      "const": "llm_clean_patch_v1"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_index", "segment_type", "segment_index", "replacement"],
        "properties": {
          "message_index": {
            "type": "integer",
            "minimum": 0
          },
          "segment_type": {
            "enum": ["thought", "final_summary"]
          },
          "segment_index": {
            "type": "integer",
            "minimum": 0
          },
          "replacement": {
            "type": "string",
            "maxLength": 12000
          }
        }
      }
    }
  }
}
