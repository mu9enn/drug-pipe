# Copy this file to .env once before running mol-pipeline.

# The only MCP endpoint used by VS/AC/PF/E2E/KG.
MOLCLAW_SCP_MCP_URL=
MOLCLAW_SCP_MCP_AUTH_HEADER=SCP-HUB-API-KEY
MOLCLAW_SCP_MCP_AUTH=

# Provider selection is external/manual; scripts do not switch providers.
CC_SWITCH_PROVIDER=manual

# Optional Python executable used by pipeline scripts
PYTHON_BIN=python
