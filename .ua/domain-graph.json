      "id": "domain:scientific-task-design",
      "type": "domain",
      "name": "科学工具理解与出题",
      "summary": "把真实工具接口和有出处的科学材料转成可执行问题。候选调度、关系裁决与问题生成各有自己的事实来源，图上有效或题目生成成功都不等于科学联调完成。",
      "tags": [
        "科学工具理解与出题",
        "意图审阅"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "工具卡",
          "方向性工具关系",
          "Science-KB种子",
          "公开题面",
          "隐藏工具链"
        ],
        "businessRules": [
          "MCP schema决定参数事实，Agent只补有依据的语义，不能制造slot。",
          "taxonomy只调度候选，不直接决定科学边；valid边仍需真实任务验证。",
          "隐藏工具链是出题蓝图，不要求求解Agent照抄。泄露提示目前是soft warning，重复上限有回退行为。"
        ],
        "crossDomainInteractions": [
          "向采集域交付公开题面、初始输入和内部来源材料。",
          "为证据修订提供问题契约及工具语义参考。"
        ]
      }
    },
