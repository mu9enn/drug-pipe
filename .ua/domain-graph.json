          "原始会话",
          "attempt",
          "selected manifest",
          "工具准入claim"
        ],
        "businessRules": [
          "公开执行目录与含答案sidecar分开；目录隔离不是OS权限沙箱。",
          "选中raw按字节复制并核hash，不覆盖失败attempt。",
          "工具claim只在单controller内协调预计工具链，不等于跨机全局锁。",
          "文件齐全、会话退出或有结果内容不证明全部科学交付完成。"
        ],
        "crossDomainInteractions": [
          "消费出题域的公开任务；向证据修订域提供raw、观察和来源绑定。",
          "与在线评测共用科学工具服务，但采集与正式评测的题集及目的分开。"
        ]
      }
    },
    {
      "id": "domain:evidence-preserving-curation",
      "type": "domain",
      "name": "证据修订与教学派生",
      "summary": "将原始会话还原为模型无关的决策与观察，再进行受限的答案和reasoning修订。每项派生保留来源，既不把教师运行噪声教给学生，也不把格式恢复说成科学证据被补齐。",
      "tags": [
        "证据修订与教学派生",
        "意图审阅"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "semantic母数据",
          "调用ID",
          "观察证据",
          "reasoning patch",
          "答案恢复",
          "skill派生步骤"
        ],
        "businessRules": [
          "同一真实response中的并行调用保持一个decision，观察必须按调用ID对应。",
          "补入的skill教学步骤是派生事件，不是teacher当时实际执行的动作。",
          "Stage1无效patch可回退并warning保留合规终答；Stage2失败进入pending，处理一次不保证达到目标长度。",
          "KG/E2E禁止自动从skill示例重建科学终答；现有通用验收未覆盖所有题目的数量、方法和产物要求。",
          "物理session路径参与semantic ID；跨目录迁移及改题仍需稳定source lineage辅助分组。"
        ],
        "crossDomainInteractions": [
          "读取采集证据并向原生训练域交付带审计的semantic视图。",
          "评测诊断可以供人工决定后续修订，不会自动回写raw或canonical母数据。"
        ]
      }
    },
    {
      "id": "domain:native-sft-delivery",
      "type": "domain",
      "name": "原生SFT发布与训练",
      "summary": "把审阅后的semantic投影为Qwen原生消息，绑定真实tokenizer、监督mask和完整轨迹长度，再进行离线训练与模型产物验收。数据可训练、数值健康和科学能力提升分别判断。",
      "tags": [
        "原生SFT发布与训练",
        "意图审阅"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "structured messages",
          "工具schema",
          "loss mask",
          "release manifest",
          "长度probe",
          "checkpoint",
          "HF模型"
        ],
        "businessRules": [
          "system、user和tool观察不参与监督；assistant推理、调用和终答参与监督。",
          "正式长度门禁保留完整轨迹，超长样本留审计并排除训练，不截断或补重复样本。",
          "发布目录不可覆盖，但失败可能留下部分目录；目录存在不等于release成功。",
          "正式SFT不执行真实MCP。旧ToolRL/GAD是独立研究支线，不是当前SFT必经阶段。",
          "完整重载forward针对probe；最终HF的索引与分片检查不能被表述为最终模型已独立科学验证。",
          "资源池和环境布局须由入口实际支持；提交参数可配置不等于所有旧编排已同步。"
        ],
        "crossDomainInteractions": [
          "消费带来源的semantic并产出绑定release的模型供评测。",
          "训练中发现的结构或长度问题返回审计，不直接删除原始证据。"
        ]
      }
    },
    {
      "id": "domain:real-tool-evaluation",
      "type": "domain",
      "name": "真实工具评测与运行收尾",
      "summary": "在冻结题集和实际工具协议下检验模型行为，区分模型错误、工具业务错误与基础设施故障。有限恢复保留原attempt和计算身份，计分与资源释放各自留下证据。",
