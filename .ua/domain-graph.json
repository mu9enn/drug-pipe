        "真实工具评测与运行收尾",
        "意图审阅"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "冻结题集",
          "协议探针",
          "DSH session",
          "持久工具job ID",
          "attempt",
          "评分视图",
          "GPU租约"
        ],
        "businessRules": [
          "HTTP200不是MCP完整就绪；9月22日run目录的新启动钩子尚未进入通用CPU入口。",
          "网络续查保持同一后端任务ID和参数；不按成绩挑选最优attempt。",
          "模型超限、格式错误和整题预算耗尽不按网络问题无限补跑；失败仍留在选定题集分母。",
          "runner退出0、rollout.complete、publishable和科学分数是不同字段。",
          "EXIT cleanup已接有界进程树处理；旧polling worker及bootstrap失败路径仍有未覆盖的直接wait。",
          "题集、skill、工具协议及分数口径绑定版本，诊断子集不可冒充无偏全量基准。"
        ],
        "crossDomainInteractions": [
          "读取训练模型并输出可追溯评测证据。",
          "结果供项目负责人判断下一轮数据或训练改进；不自动修订已发布数据。"
        ]
      }
    },
