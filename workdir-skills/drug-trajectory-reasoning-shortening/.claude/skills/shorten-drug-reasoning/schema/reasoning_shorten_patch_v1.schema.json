{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "reasoning_replacements"],
  "properties": {
    "schema_version": {"const": "reasoning_shorten_patch_v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "reasoning_replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "replacement"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "replacement": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
